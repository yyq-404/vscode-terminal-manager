{
	"name": "terminal-manager",
	"displayName": "Terminal Manager",
	"description": "Choose which terminal to use in single click and switch between multiple terminals. ",
	"version": "1.1.0",
	"publisher": "saurabh",
	"author": {
		"name": "saurabhdaware"
	},
	"icon": "resources/icon.png",
	"engines": {
		"vscode": "^1.66.0"
	},
	"categories": [
		"Other"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/saurabhdaware/vscode-terminal-manager.git"
	},
	"license": "MIT",
	"homepage": "https://github.com/saurabhdaware/vscode-terminal-manager/blob/master/README.md",
	"bugs": {
		"url": "https://github.com/saurabhdaware/vscode-terminal-manager/issues",
		"email": "saurabhdaware99@gmail.com"
	},
	"keywords": [
		"Terminal Manager",
		"Multiple Terminal",
		"Switch Terminal",
		"Ubuntu Terminal",
		"Windows Terminal"
	],
	"activationEvents": [
		"onView:terminal-manager",
		"onCommand:terminalManager.addTerminal",
		"onCommand:terminalManager.addGroup",
		"onCommand:terminalManager.editJson",
		"onCommand:extension.editTerminals"
	],
	"main": "./extension.js",
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "terminal-manager",
					"title": "Terminal Manager",
					"icon": "resources/terminal.png"
				}
			]
		},
		"views": {
			"terminal-manager": [
				{
					"id": "terminal-manager",
					"name": "Terminals",
					"icon": "resources/terminal.png"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "terminal-manager",
				"contents": "[Add Group](command:terminalManager.addGroup)\n[Add Terminal](command:terminalManager.addTerminal)"
			}
		],
		"commands": [
			{
				"command": "terminalManager.addTerminal",
				"title": "Add Terminal",
				"category": "Terminal Manager",
				"icon": "$(plus)"
			},
			{
				"command": "terminalManager.addGroup",
				"title": "Add Group",
				"category": "Terminal Manager",
				"icon": "$(new-folder)"
			},
			{
				"command": "terminalManager.editItem",
				"title": "Edit",
				"category": "Terminal Manager",
				"icon": "$(edit)"
			},
			{
				"command": "terminalManager.deleteItem",
				"title": "Delete",
				"category": "Terminal Manager",
				"icon": "$(trash)"
			},
			{
				"command": "terminalManager.moveItem",
				"title": "Move to Group",
				"category": "Terminal Manager",
				"icon": "$(fold-down)"
			},
			{
				"command": "terminalManager.openTerminal",
				"title": "Open Terminal",
				"category": "Terminal Manager",
				"icon": "$(terminal)"
			},
			{
				"command": "terminalManager.expandAll",
				"title": "Expand All",
				"category": "Terminal Manager",
				"icon": "$(expand-all)"
			},
			{
				"command": "terminalManager.collapseAll",
				"title": "Collapse All",
				"category": "Terminal Manager",
				"icon": "$(collapse-all)"
			},
			{
				"command": "terminalManager.refresh",
				"title": "Refresh",
				"category": "Terminal Manager",
				"icon": "$(refresh)"
			},
			{
				"command": "terminalManager.editJson",
				"title": "Edit JSON",
				"category": "Terminal Manager",
				"icon": "$(json)"
			},
			{
				"command": "extension.editTerminals",
				"title": "Edit Terminals",
				"icon": {
					"dark": "resources/edit.png",
					"light": "resources/edit.png"
				}
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "terminalManager.addTerminal",
					"when": "view == terminal-manager",
					"group": "navigation@1"
				},
				{
					"command": "terminalManager.addGroup",
					"when": "view == terminal-manager",
					"group": "navigation@2"
				},
				{
					"command": "terminalManager.expandAll",
					"when": "view == terminal-manager",
					"group": "navigation@3"
				},
				{
					"command": "terminalManager.collapseAll",
					"when": "view == terminal-manager",
					"group": "navigation@4"
				},
				{
					"command": "terminalManager.refresh",
					"when": "view == terminal-manager",
					"group": "navigation@5"
				},
				{
					"command": "terminalManager.editJson",
					"when": "view == terminal-manager",
					"group": "navigation@6"
				}
			],
			"view/item/context": [
				{
					"command": "terminalManager.openTerminal",
					"when": "view == terminal-manager && viewItem == terminal",
					"group": "0_open"
				},
				{
					"command": "terminalManager.addTerminal",
					"when": "view == terminal-manager && viewItem == group",
					"group": "1_new"
				},
				{
					"command": "terminalManager.addGroup",
					"when": "view == terminal-manager && viewItem == group",
					"group": "1_new"
				},
				{
					"command": "terminalManager.editItem",
					"when": "view == terminal-manager",
					"group": "2_modify"
				},
				{
					"command": "terminalManager.moveItem",
					"when": "view == terminal-manager",
					"group": "2_modify"
				},
				{
					"command": "terminalManager.deleteItem",
					"when": "view == terminal-manager",
					"group": "7_delete"
				},
				{
					"command": "terminalManager.addTerminal",
					"when": "view == terminal-manager && viewItem == group",
					"group": "inline@1"
				},
				{
					"command": "terminalManager.editItem",
					"when": "view == terminal-manager",
					"group": "inline@2"
				},
				{
					"command": "terminalManager.deleteItem",
					"when": "view == terminal-manager",
					"group": "inline@3"
				}
			]
		}
	},
	"scripts": {
		"postinstall": "node ./node_modules/vscode/bin/install",
		"test": "node ./node_modules/vscode/bin/test"
	},
	"devDependencies": {
		"typescript": "^3.3.1",
		"vscode": "^1.1.28",
		"eslint": "^5.13.0",
		"@types/node": "^10.12.21",
		"@types/mocha": "^2.2.42"
	}
}
